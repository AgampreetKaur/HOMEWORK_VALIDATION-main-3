# Database
#DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/homework_grader
# For quick local dev without Postgres, you can instead use:
DATABASE_URL=sqlite:///./homework_grader.db

# File storage (local disk for dev; swap for S3 in storage.py for prod)
UPLOAD_DIR=./uploads

# OCR engine:
#   "gemini"    (default) full-page handwriting OCR via the Gemini API — best
#               on cursive/messy handwriting, reuses GEMINI_API_KEY, no model download
#   "trocr"     self-hosted handwriting model (needs the optional torch/transformers deps)
#   "tesseract" fast, printed text only
OCR_ENGINE=gemini
OCR_MAX_RESCAN_ATTEMPTS=3
# Confidence below this triggers a low-confidence flag shown to the student
OCR_LOW_CONFIDENCE_THRESHOLD=0.55

# AI grading
GEMINI_API_KEY=
GRADING_MODEL=gemini-3.6-pro
# Model used by the Gemini OCR engine (a cheap/fast "flash" model is plenty here)
OCR_GEMINI_MODEL=gemini-3.6-flash

# Celery / Redis (background jobs)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
